configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    icon-theme:         "WhiteSur-dark";
    drun-display-format: "{name}";
    window-format:      "{t}";
    font:               "Geist 13";
    highlight:          bold;
    steal-focus:        true;

    /* Custom Mode Switcher Icons (Nerd Fonts) */
    display-drun:       "󰀻"; /* Apps Icon */
    display-run:        ""; /* Terminal/Run Icon */
    display-window:     "󱂬"; /* Active Windows Icon */
}

@import "mac-colors.rasi"

/* ── Reset ── */
* {
    border-color:     transparent;
    separatorcolor:   transparent;
    background-color: transparent;
    text-color:       @fg;
}

/* ── Window – Finder-sized canvas ── */
window {
    width:            640px;
    height:           380px;
    transparency:     "real";
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    20px;
    padding:          0px;
    location:         center;
    anchor:           center;
    x-offset:         0;
    y-offset:         -20;
}

/* ── Main container ── */
mainbox {
    background-color: transparent;
    padding:          0px;
    spacing:          0px;
    children:         ["body"];
}

/* ── Body (Sidebar + Content splits) ── */
body {
    orientation:       horizontal;
    background-color:  transparent;
    spacing:           0px;
    children:          ["nav-sidebar", "main-content"];
}

/* ── macOS style left sidebar (Narrow Icon-only nav) ── */
nav-sidebar {
    expand:            false;
    width:             60px;
    background-color:  rgba(255, 255, 255, 0.02); /* subtle glass shading */
    border:            0px 1px 0px 0px;
    border-color:      @border;
    padding:           16px 0px;
    orientation:       vertical;
    children:          ["mode-switcher"];
}

/* ── Sidebar Segmented Buttons ── */
mode-switcher {
    orientation:       vertical;
    enabled:           true;
    spacing:           16px; /* equal vertical spacing */
    background-color:  transparent;
}

button {
    cursor:            pointer;
    border-radius:     10px;
    background-color:  transparent;
    text-color:        @fg-muted;
    padding:           10px 0px;
    width:             40px;
    margin:            0px 10px; /* center horizontally inside the 60px sidebar */
    font:              "GeistMono Nerd Font 13"; /* Large clean icons */
    horizontal-align:  0.5; /* center align icon inside button */
    vertical-align:    0.5;
}

button selected {
    background-color:  rgba(255, 255, 255, 0.06);
    text-color:        @accent;
}

/* ── Main Content Area (Search + List) ── */
main-content {
    orientation:       vertical;
    background-color:  transparent;
    spacing:           0px;
    children:          ["inputbar", "listview"];
}

/* ── Search bar ── */
inputbar {
    background-color: transparent;
    padding:          16px 20px;
    spacing:          0px;
    children:         ["search-icon", "entry", "case-indicator"];
    border:           0px 0px 1px 0px;
    border-color:     @border;
}

/* Search loupe icon */
search-icon {
    background-color: transparent;
    text-color:       @fg-muted;
    str:              ""; 
    expand:           false;
    font:             "GeistMono Nerd Font 12";
    vertical-align:   0.5;
    padding:          0px 10px 0px 4px;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search files and apps…";
    placeholder-color: @fg-muted;
    cursor:           text;
    font:             "Geist 12";
    vertical-align:   0.5;
    horizontal-align: 0.0;
    expand:           true;
}

case-indicator {
    background-color: transparent;
    text-color:       @fg-muted;
    spacing:          0px;
}

/* ── List view ── */
listview {
    background-color: transparent;
    padding:          12px 16px;
    spacing:          2px;
    columns:          1;
    scrollbar:        false;
    dynamic:          true;
    cycle:            true;
    layout:           vertical;
    fixed-height:     false;
}

/* ── App Row ── */
element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    spacing:          12px;
    border-radius:    10px;
    cursor:           pointer;
    orientation:      horizontal;
}

element normal.normal  { background-color: transparent; }
element normal.urgent  { background-color: transparent; text-color: #ff453a; }
element normal.active  { background-color: transparent; text-color: @accent; }

element selected.normal {
    background-color: @accent;
    text-color:       @accent-fg;
    border-radius:    10px;
}
element selected.urgent {
    background-color: #ff453a;
    text-color:       @accent-fg;
}
element selected.active {
    background-color: @accent;
    text-color:       @accent-fg;
}

element alternate.normal  { background-color: transparent; }
element alternate.urgent  { background-color: transparent; }
element alternate.active  { background-color: transparent; }

/* ── App icon ── */
element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             32px;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    cursor:           inherit;
}

/* ── App name ── */
element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "Geist 11";
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           inherit;
    expand:           true;
}

/* ── Error overlay ── */
error-message {
    background-color: @bg;
    text-color:       @fg;
    children:         ["textbox"];
}

textbox {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    font:             "Geist 11";
}
