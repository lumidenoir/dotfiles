[global]
# Monitor and positioning
monitor = 0
follow = keyboard
origin = top-right
scale = 0
title = Dunst
class = Dunst

# Dimensions
width = (280, 380)
height = (60, 350)
offset = (14, 50)
gap_size = 6
padding = 12
horizontal_padding = 14

# Visual appearance
corner_radius = 0
transparency = 0
frame_width = 1

# Typography
font = Aesthetic Iosevka Original Medium 12
line_height = 2
text_icon_padding = 14
alignment = left
vertical_alignment = center

# Behavior
sort = update
indicate_hidden = yes
stack_duplicates = yes
hide_duplicate_count = no
sticky_history = yes
history_length = 30
always_run_script = true
dmenu = /usr/bin/rofi -dmenu -p dunst:
browser = "/usr/bin/xdg-open"

# Formatting
markup = full
format = "<b>%s</b>\n%b"
word_wrap = yes
ellipsize = middle
ignore_newline = no
show_age_threshold = 60
idle_threshold = 120

# Icon
icon_path = /usr/share/icons/Papirus-Dark/48x48/actions/:/usr/share/icons/Papirus-Dark/48x48/apps/:/usr/share/icons/Papirus-Dark/48x48/devices/:/usr/share/icons/Papirus-Dark/48x48/emblems/:/usr/share/icons/Papirus-Dark/48x48/emotes/:/usr/share/icons/Papirus-Dark/48x48/mimetypes/:/usr/share/icons/Papirus-Dark/48x48/places/:/usr/share/icons/Papirus-Dark/48x48/status/:/usr/share/icons/Papirus-Dark/48x48/categories/
enable_recursive_icon_lookup = true
icon_position = left
min_icon_size = 24
max_icon_size = 48
icon_corner_radius = 0

# Progress bar
progress_bar = true
progress_bar_height = 4
progress_bar_frame_width = 0
progress_bar_min_width = 200
progress_bar_max_width = 320
progress_bar_corner_radius = 0

# Mouse interactions
show_indicators = yes
mouse_left_click = do_action, close_current
mouse_middle_click = context, close_current
mouse_right_click = close_all

# Colors
frame_color = "@frame_color@"
highlight = "@highlight@"
separator_color = "@separator_color@"

[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 6
background = "@urgency_low_bg@"
foreground = "@urgency_low_fg@"
frame_color = "@urgency_low_frame@"
# icon = /home/lumi/dotfiles/svgs/circle-info.svg

[urgency_normal]
timeout = 8
background = "@urgency_normal_bg@"
foreground = "@urgency_normal_fg@"
frame_color = "@urgency_normal_frame@"
# icon = /home/lumi/dotfiles/svgs/triangle-warning.png

[urgency_critical]
timeout = 0
background = "@urgency_critical_bg@"
foreground = "@urgency_critical_fg@"
frame_color = "@urgency_critical_frame@"
icon = /home/lumi/dotfiles/svgs/circle-xmark.svg

[stack-settings]
summary = "Settings Control"
set_stack_tag = "settings"
history_ignore = yes
icon_position = left
min_icon_size = 32
max_icon_size = 48
format = "<b>%s</b>\n%b"
alignment = left

[music-notifications]
appname = "Music Player"
set_stack_tag = "music"
alignment = left
icon_position = left
min_icon_size = 48
max_icon_size = 64
format = "<b>%s</b>\n%b"
