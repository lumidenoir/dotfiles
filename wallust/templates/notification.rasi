/* Wallust Template for Rofi */
configuration {
    show-icons: true; // Enabled for a better look
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 10";
    markup-rows: true;
    lines: 15;
    fixed-num-lines: false;
}

* {
    /* Wallust dynamic colors */
    background-color: transparent;
    bg: {{background}}cc; /* Added transparency */
    fg: {{foreground}};
    accent: {{color2}};
    urgent: {{color1}};

    selected-bg: {{color2}};
    selected-fg: {{background}};

    margin: 0;
    padding: 0;
}

window {
    location: east;
    anchor: east;
    height: 98%;
    width: 400px;
    x-offset: 0px;
    background-color: @bg;
    border: 2px 0px 2px 2px;
    border-color: @accent;
    border-radius: 15px 0px 0px 15px;
}

mainbox {
    padding: 20px;
    children: [ inputbar, listview ];
}

inputbar {
    enabled: true;
    padding: 10px;
    margin: 0 0 20px 0;
    background-color: {{color0}};
    border-radius: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: " Search Notifications...";
    placeholder-color: {{color8}};
    text-color: @fg;
}

listview {
    columns: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 12px;
}

element {
    padding: 12px;
    border-radius: 10px;
    background-color: {{color0}}; /* Subtle card background */
    text-color: @fg;
    orientation: vertical;
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-text {
    text-color: inherit;
    markup: true;
}
